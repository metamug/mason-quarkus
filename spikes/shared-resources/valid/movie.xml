<?xml version="1.0" encoding="UTF-8" ?>
<Resource xmlns="http://xml.metamug.net/resource/1.0" v="1.0">
  <Desc>Movies</Desc>
  <Request method="GET"><Sql id="list">SELECT id, name, rating FROM movie ORDER BY id</Sql></Request>
  <Request method="GET" item="true"><Sql id="one">SELECT id, name, rating FROM movie WHERE id = $id</Sql></Request>
  <Request method="POST" status="201"><Sql id="add" type="update">INSERT INTO movie (name, rating) VALUES ($name, $rating)</Sql></Request>
  <Request method="PUT" item="true" status="202"><Sql id="upd" type="update">UPDATE movie SET rating = $rating WHERE id = $id</Sql></Request>
  <Request method="DELETE" item="true" status="410"><Sql id="del" type="update">DELETE FROM movie WHERE id = $id</Sql></Request>
</Resource>
