<?xml version="1.0" encoding="UTF-8" ?>
<Resource xmlns="http://xml.metamug.net/resource/1.0" v="1.1">
  <Desc>Generated resource 1, only here to bring the set to 20 files.</Desc>
  <Request method="GET"><Sql id="all1" when="$q ne 'x'">SELECT id, name FROM thing1 ORDER BY id</Sql></Request>
  <Request method="GET" item="true"><Sql id="one1">SELECT id, name FROM thing1 WHERE id = $id</Sql></Request>
  <Request method="POST" status="201">
    <Script id="calc1" file="calc1" output="false"/>
    <Transaction when="$[calc1].ok eq true">
      <Sql id="ins1" type="update">INSERT INTO thing1 (name) VALUES ($name)</Sql>
      <Sql id="log1" type="update">INSERT INTO audit (what) VALUES ('thing1')</Sql>
    </Transaction>
  </Request>
</Resource>
