<?xml version="1.0" encoding="UTF-8" ?>
<Resource xmlns="http://xml.metamug.net/resource/1.0" v="1.4">
  <Desc>Generated resource 4, only here to bring the set to 20 files.</Desc>
  <Request method="GET"><Sql id="all4" when="$q ne 'x'">SELECT id, name FROM thing4 ORDER BY id</Sql></Request>
  <Request method="GET" item="true"><Sql id="one4">SELECT id, name FROM thing4 WHERE id = $id</Sql></Request>
  <Request method="POST" status="201">
    <Script id="calc4" file="calc4" output="false"/>
    <Transaction when="$[calc4].ok eq true">
      <Sql id="ins4" type="update">INSERT INTO thing4 (name) VALUES ($name)</Sql>
      <Sql id="log4" type="update">INSERT INTO audit (what) VALUES ('thing4')</Sql>
    </Transaction>
  </Request>
</Resource>
