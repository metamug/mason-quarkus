<?xml version="1.0" encoding="UTF-8" ?>
<Resource xmlns="http://xml.metamug.net/resource/1.0" v="1.2">
  <Desc>Generated resource 2, only here to bring the set to 20 files.</Desc>
  <Request method="GET"><Sql id="all2" when="$q ne 'x'">SELECT id, name FROM thing2 ORDER BY id</Sql></Request>
  <Request method="GET" item="true"><Sql id="one2">SELECT id, name FROM thing2 WHERE id = $id</Sql></Request>
  <Request method="POST" status="201">
    <Script id="calc2" file="calc2" output="false"/>
    <Transaction when="$[calc2].ok eq true">
      <Sql id="ins2" type="update">INSERT INTO thing2 (name) VALUES ($name)</Sql>
      <Sql id="log2" type="update">INSERT INTO audit (what) VALUES ('thing2')</Sql>
    </Transaction>
  </Request>
</Resource>
