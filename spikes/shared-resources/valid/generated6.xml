<?xml version="1.0" encoding="UTF-8" ?>
<Resource xmlns="http://xml.metamug.net/resource/1.0" v="1.6">
  <Desc>Generated resource 6, only here to bring the set to 20 files.</Desc>
  <Request method="GET"><Sql id="all6" when="$q ne 'x'">SELECT id, name FROM thing6 ORDER BY id</Sql></Request>
  <Request method="GET" item="true"><Sql id="one6">SELECT id, name FROM thing6 WHERE id = $id</Sql></Request>
  <Request method="POST" status="201">
    <Script id="calc6" file="calc6" output="false"/>
    <Transaction when="$[calc6].ok eq true">
      <Sql id="ins6" type="update">INSERT INTO thing6 (name) VALUES ($name)</Sql>
      <Sql id="log6" type="update">INSERT INTO audit (what) VALUES ('thing6')</Sql>
    </Transaction>
  </Request>
</Resource>
